// Cloudflare Workers static assets: no Worker script, so every request is a free
// static-asset request. Headers come from out/_headers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logiqore-website",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
}
